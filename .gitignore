# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# build output
*.apk

# TaskNote is its own repo (github.com/greatrifat/tasknote), kept here so the
# app and the API it posts to can be changed together. Ignored so this repo
# never commits it as a stray gitlink.
tasknote/
